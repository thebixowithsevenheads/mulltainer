[0.015, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.000, "o", "\u001b[38;2;108;137;168m$\u001b[0m sudo bash install.sh\r\n"]
[0.801, "o", "\r\n\u001b[38;2;255;213;36m  ██    ██  ██  ██  ██     ██     ██████  ██████  ████  ██   ██  █████  █████ \u001b[0m\r\n"]
[0.000, "o", "\u001b[38;2;212;186;52m  ████████  ██  ██  ██     ██       ██    ██  ██   ██   ███  ██  ██     ██  ██\u001b[0m\r\n"]
[0.000, "o", "\u001b[38;2;169;159;68m  ██ ██ ██  ██  ██  ██     ██       ██    ██████   ██   ██ █ ██  ████   █████ \u001b[0m\r\n\u001b[38;2;127;131;83m  ██ ██ ██  ██  ██  ██     ██       ██    ██  ██   ██   ██  ███  ██     ██ ██ \u001b[0m\r\n"]
[0.000, "o", "\u001b[38;2;84;104;99m  ██    ██  ██  ██  ██     ██       ██    ██  ██   ██   ██   ██  ██     ██  ██\u001b[0m\r\n"]
[0.001, "o", "\u001b[38;2;41;77;115m  ██    ██  ██████  █████  █████    ██    ██  ██  ████  ██   ██  █████  ██  ██\u001b[0m\r\n"]
[0.000, "o", "  \u001b[38;2;255;213;36mExegol + Mullvad\u001b[0m  \u001b[38;2;108;137;168m·\u001b[0m  \u001b[38;2;108;137;168mkill switch em duas camadas\u001b[0m\r\n\r\n"]
[0.000, "o", "    Distro             arch\r\n"]
[0.000, "o", "    Docker             ok, ativo\r\n"]
[0.000, "o", "    Exegol             v5.1.11\r\n"]
[0.000, "o", "    Imagem             free nao instalada\r\n"]
[0.000, "o", "    Config Mullvad     nenhuma encontrada\r\n"]
[0.000, "o", "    Container          nao existe\r\n"]
[0.000, "o", "    Kill switch        inativo\r\n"]
[0.000, "o", "    Watcher            inativo\r\n"]
[0.000, "o", "\r\n"]
[1.001, "o", "    1) Instalacao completa   <- faz tudo, do zero\r\n    2) So dependencias\r\n    3) So config Mullvad\r\n    4) So o container\r\n    5) So o kill switch\r\n    6) Verificar / testar vazamento\r\n    7) Desinstalar\r\n"]
[0.000, "o", "    0) Sair\r\n\r\n"]
[1.201, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m escolha> \u001b[1m1\u001b[0m\r\n"]
[0.501, "o", "\r\n\u001b[1m>>> Dependencias\u001b[0m\r\n"]
[0.401, "o", "\u001b[38;2;41;77;115m[*]\u001b[0m Distro detectada: arch\r\n"]
[0.401, "o", "\u001b[32m[+]\u001b[0m docker: presente\r\n\u001b[32m[+]\u001b[0m pipx: presente\r\n\u001b[38;2;255;213;36m[!]\u001b[0m wg: ausente -> pacote wireguard-tools\r\n"]
[0.000, "o", "\u001b[32m[+]\u001b[0m iptables: presente\r\n"]
[0.000, "o", "\u001b[32m[+]\u001b[0m curl: presente\r\n"]
[0.000, "o", "\u001b[32m[+]\u001b[0m python3: presente\r\n"]
[0.502, "o", "\u001b[38;2;41;77;115m[*]\u001b[0m Vou rodar: pacman -S --needed --noconfirm wireguard-tools\r\n\u001b[38;2;255;213;36m[?]\u001b[0m Instalar os pacotes que faltam? [S/n] \u001b[1ms\u001b[0m\r\n"]
[1.302, "o", "\u001b[32m[+]\u001b[0m docker.service ativo\r\n\u001b[32m[+]\u001b[0m exegol: v5.1.11\r\n"]
[0.601, "o", "\r\n\u001b[1mImagens do Exegol\u001b[0m\r\n\r\n  \u001b[38;2;255;213;36mfree\u001b[0m   gratuita, sem assinatura -- e o padrao aqui\r\n  as demais aparecem marcadas \"Pro / Enterprise only\" na tabela abaixo\r\n\r\n"]
[0.000, "o", "  ┌─────────┬──────────┬───────────────────────┐\r\n  │ Image   │ Size     │ Status                │\r\n"]
[0.000, "o", "  ├─────────┼──────────┼───────────────────────┤\r\n"]
[0.000, "o", "  │ free    │ ~42 GB   │ Not installed         │\r\n"]
[0.000, "o", "  │ full    │ 45.09 GB │ Pro / Enterprise only │\r\n"]
[0.000, "o", "  └─────────┴──────────┴───────────────────────┘\r\n\r\n"]
[1.001, "o", "  Espaco livre em /var/lib/docker: 214 GB\r\n\u001b[38;2;255;213;36m[?]\u001b[0m Baixar agora? [S/n] \u001b[1ms\u001b[0m\r\n"]
[1.303, "o", "  \u001b[38;2;108;137;168m[i]\u001b[0m baixando nwodtuhs/exegol:free ... (alguns minutos)\u001b[0m\r\n"]
[1.201, "o", "\u001b[32m[+]\u001b[0m imagem free instalada\r\n"]
[0.601, "o", "\r\n\u001b[1m>>> Config Mullvad\u001b[0m\r\n"]
[0.401, "o", "\r\n\u001b[1mConfig da Mullvad\u001b[0m\r\n\r\n  1) Ja tenho um .conf\r\n  2) Gerar pelo numero da conta\r\n  0) Voltar\r\n\r\n"]
[0.901, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m escolha> \u001b[1m2\u001b[0m\r\n"]
[1.002, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m numero da conta Mullvad (16 digitos): \r\n"]
[0.702, "o", "\u001b[38;2;41;77;115m[*]\u001b[0m Conta ************4712: consultando...\r\n"]
[1.001, "o", "\u001b[32m[+]\u001b[0m Conta valida. Expira em: 2027-03-14\r\n"]
[0.501, "o", "\u001b[38;2;255;213;36m[!]\u001b[0m Vou registrar uma chave nova. A Mullvad permite 5 por conta.\r\n\u001b[38;2;255;213;36m[?]\u001b[0m Continuar? [S/n] \u001b[1ms\u001b[0m\r\n"]
[1.403, "o", "\u001b[32m[+]\u001b[0m Chave registrada. Endereco atribuido: 10.68.4.219/32\r\n"]
[0.601, "o", "\r\n\u001b[1mPais de saida\u001b[0m\r\n\r\n   12) Brazil\r\n   47) Sweden\r\n   49) Switzerland\r\n  \u001b[38;2;108;137;168m... 50 paises, 553 relays\u001b[0m\r\n\r\n"]
[0.901, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m pais> \u001b[1m12\u001b[0m\r\n"]
[0.501, "o", "\r\n\u001b[1mRelay em Brazil\u001b[0m\r\n\r\n    1) br-for-wg-001  (Fortaleza)\r\n    2) br-sao-wg-101  (Sao Paulo)\r\n\r\n"]
[0.801, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m relay> \u001b[1m2\u001b[0m\r\n"]
[1.302, "o", "\u001b[32m[+]\u001b[0m Conf gerado: /etc/wireguard/mullvad/br-sao-wg-101.conf\r\n"]
[0.601, "o", "\r\n\u001b[1m>>> Container\u001b[0m\r\n"]
[0.403, "o", "\u001b[38;2;41;77;115m[*]\u001b[0m Criando a rede exegol-vpn-net (172.30.30.0/24)...\r\n"]
[0.701, "o", "\u001b[32m[+]\u001b[0m rede criada\r\n\u001b[38;2;41;77;115m[*]\u001b[0m Criando exegol-mullvad com capabilities de VPN...\r\n"]
[1.101, "o", "\u001b[32m[+]\u001b[0m capabilities conferidas: NET_ADMIN + src_valid_mark\r\n\u001b[38;2;41;77;115m[*]\u001b[0m Fixando 172.30.30.10 em exegol-vpn-net...\r\n"]
[0.801, "o", "\u001b[32m[+]\u001b[0m IP fixo: 172.30.30.10\r\n\u001b[32m[+]\u001b[0m payload instalado em /home/demon7/.exegol/my-resources/bin\r\n\u001b[32m[+]\u001b[0m conf instalado em /etc/wireguard/wg0.conf dentro do container\r\n"]
[0.000, "o", "\u001b[32m[+]\u001b[0m alias mullvad-switch instalado\r\n"]
[0.601, "o", "\r\n\u001b[1m>>> Kill switch\u001b[0m\r\n"]
[0.401, "o", "\u001b[32m[+]\u001b[0m scripts do host instalados em /usr/local/sbin\r\n"]
[0.701, "o", "\u001b[32m[+]\u001b[0m exegol-mullvad-killswitch-watcher.service: ativo e habilitado no boot\r\n"]
[0.502, "o", "\u001b[38;2;41;77;115m[*]\u001b[0m Estado atual da chain EXEGOL-MULLVAD-KS:\r\nChain EXEGOL-MULLVAD-KS (1 references)\r\n pkts bytes target  prot opt in  out  source        destination\r\n    0     0 DROP    all  --  *   *    172.30.30.10  0.0.0.0/0\r\n    0     0 DROP    all  --  *   *    0.0.0.0/0     172.30.30.10\r\n"]
[1.000, "o", "\u001b[38;2;41;77;115m[*]\u001b[0m Subindo o tunel pela primeira vez...\r\n"]
[1.302, "o", "\r\n\u001b[1m>>> Verificacao\u001b[0m\r\n"]
[0.401, "o", "\r\n\u001b[1mVerificacao\u001b[0m\r\n\r\n  \u001b[32m[PASSA]\u001b[0m handshake do wg0 estabelecido\r\n"]
[0.351, "o", "  \u001b[32m[PASSA]\u001b[0m saindo pela Mullvad: 45.134.140.77 (Sao Paulo, Brazil)\r\n"]
[0.351, "o", "  \u001b[32m[PASSA]\u001b[0m resolv.conf aponta para o DNS da Mullvad (10.64.0.1)\r\n"]
[0.351, "o", "  \u001b[32m[PASSA]\u001b[0m IPv6 bloqueado\r\n"]
[0.351, "o", "  \u001b[32m[PASSA]\u001b[0m watcher da camada 2 ativo (exegol-mullvad-killswitch-watcher.service)\r\n"]
[0.853, "o", "\r\n\u001b[1mTeste de vazamento -- derrubando o tunel de proposito\u001b[0m\r\n\r\n"]
[0.901, "o", "  \u001b[32m[PASSA]\u001b[0m camada 1: sem tunel, nada sai do container\r\n"]
[0.852, "o", "  \u001b[32m[PASSA]\u001b[0m camada 2: descartou o trafego com a camada 1 desativada (0 -> 7)\r\n"]
[0.852, "o", "\u001b[38;2;41;77;115m[*]\u001b[0m Restaurando o tunel...\r\n"]
[1.002, "o", "  \u001b[32m[PASSA]\u001b[0m tunel restaurado e saindo pela Mullvad\r\n"]
[0.351, "o", "\r\n\u001b[32m[+]\u001b[0m Tudo passou. O kill switch esta protegendo nas duas camadas.\r\n\r\n"]
[0.801, "o", "\u001b[32m[+]\u001b[0m Pronto. Use: exegol start mullvad   e dentro dele: mullvad-switch\r\n"]
[1.602, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.000, "o", "\u001b[38;2;108;137;168m$\u001b[0m exegol start mullvad\r\n"]
[1.001, "o", "\u001b[31mdemon7\u001b[0m@\u001b[38;2;255;255;255msect\u001b[0m ~ $ mullvad-switch\r\n"]
[0.902, "o", "\r\n\u001b[48;2;41;77;115m\u001b[38;2;255;213;36m\u001b[1m                         M U L L V A D   S W I T C H                          \u001b[0m\r\n"]
[0.001, "o", "\u001b[48;2;41;77;115m\u001b[38;2;108;137;168m                   container Exegol que so sai pela Mullvad                   \u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[38;2;108;137;168m553 relays disponiveis.\u001b[0m\r\n"]
[0.801, "o", "\r\n\u001b[48;2;41;77;115m\u001b[38;2;255;213;36m\u001b[1m modo                                                                         \u001b[0m\r\n\r\n"]
[0.000, "o", "  \u001b[38;2;255;213;36m  1)\u001b[0m Trocar so a saida  (mantem a entrada br-sao-wg-101)\r\n"]
[0.000, "o", "  \u001b[38;2;255;213;36m  2)\u001b[0m Multihop completo  (escolher entrada e saida)\r\n"]
[0.000, "o", "  \u001b[38;2;255;213;36m  3)\u001b[0m Single-hop  (um relay so)\r\n"]
[0.000, "o", "  \u001b[38;2;255;213;36m  4)\u001b[0m Ver status\r\n"]
[1.002, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m modo> \u001b[1m2\u001b[0m\r\n"]
[1.103, "o", "\r\n\u001b[48;2;41;77;115m\u001b[38;2;255;213;36m\u001b[1m ENTRADA / pais                                                               \u001b[0m\r\n\r\n"]
[0.000, "o", "  \u001b[38;2;255;213;36m 47)\u001b[0m Sweden  (23 relays)\r\n"]
[0.701, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m ENTRADA / pais> \u001b[1m47\u001b[0m\r\n"]
[0.501, "o", "  \u001b[38;2;255;213;36m  1)\u001b[0m se-got-wg-007  Gothenburg\r\n"]
[0.601, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m ENTRADA / Sweden> \u001b[1m1\u001b[0m\r\n"]
[1.103, "o", "\r\n\u001b[48;2;41;77;115m\u001b[38;2;255;213;36m\u001b[1m SAIDA / pais                                                                 \u001b[0m\r\n\r\n"]
[0.000, "o", "  \u001b[38;2;255;213;36m 49)\u001b[0m Switzerland  (11 relays)\r\n"]
[0.701, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m SAIDA / pais> \u001b[1m49\u001b[0m\r\n"]
[0.501, "o", "  \u001b[38;2;255;213;36m  3)\u001b[0m ch-zrh-wg-503  Zurich\r\n"]
[0.601, "o", "\u001b[38;2;255;213;36m[?]\u001b[0m SAIDA / Switzerland> \u001b[1m3\u001b[0m\r\n"]
[1.203, "o", "\r\nMultihop: se-got-wg-007 -> ch-zrh-wg-503 (Zurich, Switzerland)\r\n"]
[0.801, "o", "\u001b[38;2;108;137;168mconfirmando a saida (ate 10s)...\u001b[0m\r\n"]
[1.801, "o", "\u001b[32m[+]\u001b[0m conectado\r\n\r\n  \u001b[38;2;108;137;168mIP de saida .........\u001b[0m 185.213.155.74\r\n"]
[0.000, "o", "  \u001b[38;2;108;137;168mLocalizacao .........\u001b[0m Zurich, Switzerland\r\n"]
[0.000, "o", "  \u001b[38;2;108;137;168mSaindo pela Mullvad .\u001b[0m \u001b[32msim\u001b[0m\r\n\r\n"]
[2.201, "x", "0"]
